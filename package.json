{
  "name": "pehra",
  "version": "1.0.0",
  "private": true,
  "description": "Pehra - an AI watchkeeper for the legal paperwork ordinary Indians are asked to sign.",
  "license": "MIT",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@google/genai": "^1.12.0",
    "next": "15.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.10.2",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild": true,
    "protobufjs": true,
    "sharp": true,
    "@google/genai": true,
    "esbuild@0.21.5": true,
    "protobufjs@7.6.6": true,
    "sharp@0.34.5": true,
    "@google/genai@1.52.0": true
  }
}
